# get data first
all_lines <- readLines("http://66.212.21.196/devices_raw/RB/logs/rotated/")
files <- regmatches(
all_lines,
gregexpr("RB_[0-9]{8}_[0-9]{6}\\.txt", all_lines)
)
# Flatten list
files <- unique(unlist(files))
files <- files[which(files == 'RB_20260319_000001.txt'):length(files)]
parse_line <- function(line) {
# Split timestamp and data payload
parts <- regmatches(line, regexpr("^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}", line))
timestamp <- as.POSIXct(parts, format = "%Y-%m-%d %H:%M:%S")
# Extract key=value pairs (everything after "RB,1," or "RB,5,")
payload <- sub("^.*?RB,\\d+,", "", line)
pairs <- strsplit(payload, ",")[[1]]
# Parse into named vector, skipping entries without "="
kv <- pairs[grepl("=", pairs)]
keys   <- trimws(sub("=.*", "", kv))
values <- trimws(sub(".*=", "", kv))
result <- as.list(setNames(values, keys))
result$timestamp <- timestamp
result
}
df2_all <- data.frame()
df5_all <- data.frame()
for (i in files){
print(i)
lines <- readLines(paste0("http://66.212.21.196/devices_raw/RB/logs/rotated/", i))
# this gives us only the pressure, methane and flourescence values
lines_rb2 <- lines[grepl("^\\d{4}-\\d{2}-\\d{2}.*RB,2,", lines)]
lines_rb5 <- lines[grepl("^\\d{4}-\\d{2}-\\d{2}.*RB,5,", lines)]
suppressMessages(
df_rb2 <- bind_rows(lapply(lines_rb2, parse_line)) |>
mutate(across(-c(timestamp, TS), as.numeric))
)
df2_all <- rbind(df2_all, df_rb2)
suppressMessages(
df_rb5 <- bind_rows(lapply(lines_rb5, parse_line)) |>
mutate(across(-c(timestamp, TS), as.numeric))
)
if ("SKIPPED" %in% names(df_rb5)){
df_rb5 <- df_rb5 %>% select(-SKIPPED)
}
df5_all <- rbind(df5_all, df_rb5)
}
