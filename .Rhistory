profiles = field %>% mutate(Day = factor(Day)) %>%
rename(Date = Day, Depth_m = Depth_m, RDO = RDO_Concentration_mg_L) %>%
select(Date, Depth_m, RDO) %>%
arrange(Date, Depth_m) %>%
group_by(Date) %>%
group_split(Date)
depths <- sort(unique(field$Depth_m))
evaluate_depths <- function(selected_depths, profiles){
cors <- numeric(length(profiles))
for(i in seq_along(profiles)){
p <- profiles[[i]]
true_depth <- p %>% pull(Depth_m)
true_rdo   <- p %>% pull(RDO)
# interpolate measurements at chosen depths
sampled <- approx(true_depth, true_rdo, xout = selected_depths)$y
# reconstruct full profile
recon <- approx(selected_depths, sampled, xout = true_depth)$y
cors[i] <- cor(true_rdo, recon, use = "complete.obs")
}
mean(cors, na.rm = TRUE)
}
selected <- c()
for(i in 1:6){
best_depth <- NULL
best_score <- -Inf
for(d in setdiff(depths, selected)){
test <- c(selected, d)
score <- evaluate_depths(test, profiles)
if(score > best_score){
best_depth <- d
best_score <- score
}
}
selected <- c(selected, best_depth)
}
profiles
